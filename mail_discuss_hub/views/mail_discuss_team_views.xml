<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_discuss_team_view_list" model="ir.ui.view">
        <field name="name">mail.discuss.team.list</field>
        <field name="model">mail.discuss.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="company_id" />
                <field name="user_id" />
                <field name="member_ids" widget="many2many_tags" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="mail_discuss_team_view_form" model="ir.ui.view">
        <field name="name">mail.discuss.team.form</field>
        <field name="model">mail.discuss.team</field>
        <field name="arch" type="xml">
            <form string="Discuss Team">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="active" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="company_id" />
                            <field name="user_id" />
                            <field name="color" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="member_ids" widget="many2many_tags" />
                        </page>
                        <page string="Integrations" name="integrations" />
                        <page string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_discuss_team_action" model="ir.actions.act_window">
        <field name="name">Discuss Teams</field>
        <field name="res_model">mail.discuss.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
