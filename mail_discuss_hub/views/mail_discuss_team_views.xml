<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_discuss_team_view_list" model="ir.ui.view">
        <field name="name">mail.discuss.team.list</field>
        <field name="model">mail.discuss.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="company_id" />
                <field name="user_id" />
                <field name="member_ids" widget="many2many_tags" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="mail_discuss_team_view_form" model="ir.ui.view">
        <field name="name">mail.discuss.team.form</field>
        <field name="model">mail.discuss.team</field>
        <field name="arch" type="xml">
            <form string="Discuss Team">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Sales"
                                class="oe_inline"
                            />
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="active" />
                            <field name="company_id" />
                        </group>
                        <group>
                            <field name="user_id" />
                        </group>
                    </group>

                    <field name="sequence" invisible="1" />
                    <field name="color" invisible="1" />
                    <notebook>
                        <page string="Members">
                            <group>
                                <field
                                    name="member_ids"
                                    widget="many2many_avatar_user"
                                    options="{'no_create': True}"
                                />
                                <field name="access_group_id" readonly="1" />
                            </group>
                        </page>
                        <page
                            string="Integrations"
                            name="integrations"
                            invisible="not has_integrations"
                        />
                        <page string="Description">
                            <field name="description" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_discuss_team_action" model="ir.actions.act_window">
        <field name="name">Discuss Teams</field>
        <field name="res_model">mail.discuss.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
