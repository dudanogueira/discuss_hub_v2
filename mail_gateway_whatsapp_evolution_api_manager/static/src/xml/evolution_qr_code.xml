<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail_gateway_whatsapp_evolution_api_manager.EvolutionQrCodeField" t-inherit="web.ImageField" t-inherit-mode="primary">
        <xpath expr="//img" position="after">
            <div t-if="canRefreshQr" class="mt-2 text-center">
                <button
                    type="button"
                    class="btn btn-secondary btn-sm"
                    t-on-click.prevent.stop="onRefreshQr"
                >
                    <i class="fa fa-refresh me-1" />
                    Refresh QR
                </button>
            </div>
        </xpath>
    </t>
</templates>
