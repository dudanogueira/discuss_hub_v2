<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="evolution_api_server_view_list" model="ir.ui.view">
        <field name="name">evolution.api.server.list</field>
        <field name="model">evolution.api.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="base_url" />
                <field name="company_id" />
                <field name="instance_count" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="evolution_api_server_view_form" model="ir.ui.view">
        <field name="name">evolution.api.server.form</field>
        <field name="model">evolution.api.server</field>
        <field name="arch" type="xml">
            <form string="Evolution API Server">
                <header>
                    <button
                        name="action_sync_instances"
                        type="object"
                        string="Sync Instances"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="base_url" />
                            <field name="api_key" password="True" />
                        </group>
                        <group>
                            <field name="company_id" />
                            <field name="instance_count" readonly="1" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Instances">
                            <field name="instance_ids">
                                <list>
                                    <field name="name" />
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-success="status == 'connected'"
                                        decoration-warning="status == 'connecting'"
                                        decoration-danger="status == 'disconnected'"
                                        decoration-muted="status == 'unknown'"
                                    />
                                    <field name="connection_status" />
                                    <field
                                        name="gateway_state"
                                        widget="badge"
                                        decoration-success="gateway_state == 'with_gateway'"
                                        decoration-muted="gateway_state == 'no_gateway'"
                                    />
                                    <field name="profile_name" />
                                    <field name="phone_number" />
                                    <field name="last_sync" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_evolution_api_server" model="ir.actions.act_window">
        <field name="name">Evolution API Servers</field>
        <field name="res_model">evolution.api.server</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
