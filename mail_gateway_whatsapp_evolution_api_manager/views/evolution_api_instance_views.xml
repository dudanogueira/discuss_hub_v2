<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="evolution_api_instance_view_list" model="ir.ui.view">
        <field name="name">evolution.api.instance.list</field>
        <field name="model">evolution.api.instance</field>
        <field name="arch" type="xml">
            <list delete="false">
                <field name="name" />
                <field name="server_id" />
                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'connected'"
                    decoration-warning="status == 'connecting'"
                    decoration-danger="status == 'disconnected'"
                    decoration-muted="status == 'unknown'"
                />
                <field name="connection_status" />
                <field
                    name="gateway_state"
                    widget="badge"
                    decoration-success="gateway_state == 'with_gateway'"
                    decoration-muted="gateway_state == 'no_gateway'"
                />
                <field name="profile_name" />
                <field name="phone_number" />
                <field name="last_sync" />
            </list>
        </field>
    </record>

    <record id="evolution_api_instance_view_kanban" model="ir.ui.view">
        <field name="name">evolution.api.instance.kanban</field>
        <field name="model">evolution.api.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" group_create="0" import="false">
                <field name="name" />
                <field name="server_id" />
                <field name="status" />
                <field name="profile_name" />
                <field name="phone_number" />
                <field name="last_sync" />
                <field name="gateway_id" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click card shadow-sm h-100">
                            <div class="card-body pb-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="me-2 overflow-hidden">
                                        <strong class="card-title mb-1 text-truncate">
                                            <t t-esc="record.name.value" />
                                        </strong>
                                        <div class="text-muted small text-truncate">
                                            <t t-esc="record.server_id.value" />
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <a
                                            role="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            title="Menu"
                                            class="text-muted"
                                        >
                                            <i class="fa fa-cog" />
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center mt-2">
                                    <div class="flex-grow-1 text-truncate">
                                        <div t-if="record.profile_name.value" class="fw-semibold">
                                            <t t-esc="record.profile_name.value" />
                                        </div>
                                        <div t-if="record.phone_number.value" class="text-muted">
                                            <t t-esc="record.phone_number.value" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-top-0 pt-0">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                    <div class="d-flex flex-wrap gap-1">
                                        <t t-if="record.status.raw_value == 'connected'">
                                            <span class="badge text-bg-success">
                                                <t t-esc="record.status.value" />
                                            </span>
                                        </t>
                                        <t t-if="record.status.raw_value == 'connecting'">
                                            <span class="badge text-bg-warning">
                                                <t t-esc="record.status.value" />
                                            </span>
                                        </t>
                                        <t t-if="record.status.raw_value == 'disconnected'">
                                            <span class="badge text-bg-danger">
                                                <t t-esc="record.status.value" />
                                            </span>
                                        </t>
                                        <t t-if="record.status.raw_value == 'unknown'">
                                            <span class="badge text-bg-secondary">
                                                <t t-esc="record.status.value" />
                                            </span>
                                        </t>
                                        <t t-if="record.gateway_id.raw_value">
                                            <span class="badge text-bg-primary" title="Gateway vinculado">
                                                <i class="fa fa-plug me-1" />
                                                Gateway
                                            </span>
                                        </t>
                                        <t t-if="!record.gateway_id.raw_value">
                                            <span class="badge text-bg-light text-muted" title="Sem gateway vinculado">
                                                <i class="fa fa-plug me-1" />
                                                Sem gateway
                                            </span>
                                        </t>
                                    </div>
                                    <div class="text-muted small">
                                        <t t-if="record.last_sync.value">
                                            <span title="Ultima sincronizacao">
                                                <i class="fa fa-clock-o me-1" />
                                                <t t-esc="record.last_sync.value" />
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="evolution_api_instance_view_form" model="ir.ui.view">
        <field name="name">evolution.api.instance.form</field>
        <field name="model">evolution.api.instance</field>
        <field name="arch" type="xml">
            <form string="Evolution API Instance">
                <header>
                    <button
                        name="action_create_instance"
                        type="object"
                        string="Create Instance"
                        icon="fa-plus"
                        class="btn-primary"
                        invisible="status != 'unknown'"
                    />
                    <button
                        name="action_connect"
                        type="object"
                        string="Connect"
                        icon="fa-plug"
                        class="btn-primary"
                        invisible="status == 'unknown' or status == 'connected' or status == 'connecting'"
                    />
                    <button
                        name="action_refresh_qrcode"
                        type="object"
                        string="Refresh QR"
                        icon="fa-qrcode"
                        class="btn-info"
                        invisible="status != 'connecting'"
                    />
                    <button
                        name="action_restart"
                        type="object"
                        string="Restart"
                        icon="fa-refresh"
                        class="btn-warning"
                        invisible="status != 'connected'"
                    />
                    <button
                        name="action_disconnect"
                        type="object"
                        string="Disconnect"
                        icon="fa-unlink"
                        class="btn-secondary"
                        invisible="status != 'connected'"
                    />
                    <button
                        name="action_check_status"
                        type="object"
                        string="Check Status"
                        icon="fa-info-circle"
                        class="btn-secondary"
                    />
                    <button
                        name="action_delete_instance"
                        type="object"
                        string="Delete Instance"
                        icon="fa-trash"
                        class="btn-danger"
                        confirm="A instância será deletada diretamente no servidor da Evolution API."
                        invisible="status != 'connected'"
                    />
                    <button
                        name="action_create_gateway"
                        type="object"
                        string="Create Gateway"
                        class="btn-primary"
                        invisible="gateway_id or status != 'connected'"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="status != 'unknown'" />
                            <field name="server_id" />
                            <field name="status" />
                            <field name="connection_status" />
                        </group>
                        <group>
                            <field name="profile_name" />
                            <field name="phone_number" />
                            <field name="gateway_id" options="{'no_create': True}" />
                            <field name="last_sync" />
                            <field
                                name="qr_code"
                                widget="evolution_qr_code"
                                invisible="status != 'connecting' and not qr_code"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Settings">
                            <group>
                                <group>
                                    <field name="reject_calls" />
                                    <field name="ignore_groups" />
                                    <field name="always_online" />
                                </group>
                                <group>
                                    <field name="read_messages" />
                                    <field name="sync_full_history" />
                                    <field name="read_status" />
                                </group>
                            </group>
                            <group string="Webhook" invisible="not gateway_id">
                                <group>
                                    <field name="evolution_webhook_by_events" readonly="1" />
                                    <field name="evolution_base64_webhook" />
                                </group>
                                <group>
                                    <button
                                        name="action_select_all_webhook_events"
                                        type="object"
                                        string="Mark All"
                                        class="btn-secondary"
                                    />
                                    <button
                                        name="action_clear_webhook_events"
                                        type="object"
                                        string="Unmark All"
                                        class="btn-secondary"
                                    />
                                </group>
                                <field name="evolution_webhook_event_ids" widget="many2many_checkboxes" />
                            </group>
                        </page>
                        <page string="Gateway" invisible="not gateway_id">
                            <group>
                                <group>
                                    <field name="gateway_id" options="{'no_create': True}" />
                                    <field name="gateway_type" />
                                    <field name="gateway_integrated_webhook_state" />
                                    <field name="gateway_evolution_api_url" />
                                    <field name="gateway_evolution_instance" />
                                </group>
                                <group>
                                    <field name="gateway_token" password="True" />
                                    <field name="gateway_webhook_key" />
                                    <field name="gateway_webhook_secret" password="True" />
                                    <field
                                        name="gateway_webhook_url"
                                        groups="base.group_no_one"
                                    />
                                    <field name="gateway_webhook_user_id" />
                                </group>
                            </group>
                            <group>
                                <field
                                    name="gateway_member_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_evolution_api_instance" model="ir.actions.act_window">
        <field name="name">Evolution API Instances</field>
        <field name="res_model">evolution.api.instance</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
