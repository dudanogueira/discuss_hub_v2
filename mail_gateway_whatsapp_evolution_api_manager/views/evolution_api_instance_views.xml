<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="evolution_api_instance_view_list" model="ir.ui.view">
        <field name="name">evolution.api.instance.list</field>
        <field name="model">evolution.api.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="server_id" />
                <field name="status" />
                <field name="connection_status" />
                <field name="profile_name" />
                <field name="phone_number" />
                <field name="last_sync" />
            </list>
        </field>
    </record>

    <record id="evolution_api_instance_view_kanban" model="ir.ui.view">
        <field name="name">evolution.api.instance.kanban</field>
        <field name="model">evolution.api.instance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name" />
                <field name="server_id" />
                <field name="status" />
                <field name="profile_name" />
                <field name="phone_number" />
                <field name="last_sync" />
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record">
                            <div class="o_kanban_record_top">
                                <strong class="o_text_overflow">
                                    <field name="name" />
                                </strong>
                                <span class="o_tag o_tag_secondary">
                                    <field name="status" />
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_text_overflow">
                                    <field name="profile_name" placeholder="-" />
                                </div>
                                <div class="o_text_overflow">
                                    <field name="phone_number" placeholder="-" />
                                </div>
                                <div class="text-muted o_text_overflow">
                                    <field name="server_id" />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom text-muted">
                                <field name="last_sync" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="evolution_api_instance_view_form" model="ir.ui.view">
        <field name="name">evolution.api.instance.form</field>
        <field name="model">evolution.api.instance</field>
        <field name="arch" type="xml">
            <form string="Evolution API Instance">
                <header>
                    <button
                        name="action_create_instance"
                        type="object"
                        string="Create Instance"
                        icon="fa-plus"
                        class="btn-primary"
                        invisible="status != 'unknown'"
                    />
                    <button
                        name="action_connect"
                        type="object"
                        string="Connect"
                        icon="fa-plug"
                        class="btn-primary"
                        invisible="status == 'unknown' or status == 'connected' or status == 'connecting'"
                    />
                    <button
                        name="action_refresh_qrcode"
                        type="object"
                        string="Refresh QR"
                        icon="fa-qrcode"
                        class="btn-info"
                        invisible="status != 'connecting'"
                    />
                    <button
                        name="action_restart"
                        type="object"
                        string="Restart"
                        icon="fa-refresh"
                        class="btn-warning"
                        invisible="status != 'connected'"
                    />
                    <button
                        name="action_disconnect"
                        type="object"
                        string="Disconnect"
                        icon="fa-unlink"
                        class="btn-secondary"
                        invisible="status != 'connected'"
                    />
                    <button
                        name="action_check_status"
                        type="object"
                        string="Check Status"
                        icon="fa-info-circle"
                        class="btn-secondary"
                    />
                    <button
                        name="action_delete_instance"
                        type="object"
                        string="Delete Instance"
                        icon="fa-trash"
                        class="btn-danger"
                        confirm="A instância será deletada diretamente no servidor da Evolution API."
                        invisible="status != 'connected'"
                    />
                    <button
                        name="action_create_gateway"
                        type="object"
                        string="Create Gateway"
                        class="btn-primary"
                        invisible="gateway_id or status != 'connected'"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="status != 'unknown'" />
                            <field name="server_id" />
                            <field name="status" />
                            <field name="connection_status" />
                        </group>
                        <group>
                            <field name="profile_name" />
                            <field name="phone_number" />
                            <field name="gateway_id" options="{'no_create': True}" />
                            <field name="last_sync" />
                            <field
                                name="qr_code"
                                widget="evolution_qr_code"
                                invisible="status != 'connecting' and not qr_code"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Settings">
                            <group>
                                <group>
                                    <field name="reject_calls" />
                                    <field name="ignore_groups" />
                                    <field name="always_online" />
                                </group>
                                <group>
                                    <field name="read_messages" />
                                    <field name="sync_full_history" />
                                    <field name="read_status" />
                                </group>
                            </group>
                            <group string="Webhook" invisible="not gateway_id">
                                <group>
                                    <field name="evolution_webhook_by_events" readonly="1" />
                                    <field name="evolution_base64_webhook" />
                                </group>
                                <group>
                                    <button
                                        name="action_select_all_webhook_events"
                                        type="object"
                                        string="Mark All"
                                        class="btn-secondary"
                                    />
                                    <button
                                        name="action_clear_webhook_events"
                                        type="object"
                                        string="Unmark All"
                                        class="btn-secondary"
                                    />
                                </group>
                                <field name="evolution_webhook_event_ids" widget="many2many_checkboxes" />
                            </group>
                        </page>
                        <page string="Raw Payload">
                            <field name="raw_payload" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_evolution_api_instance" model="ir.actions.act_window">
        <field name="name">Evolution API Instances</field>
        <field name="res_model">evolution.api.instance</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
