<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_guest_view_form_evolution" model="ir.ui.view">
        <field name="name">mail.guest.form.evolution.api</field>
        <field name="model">mail.guest</field>
        <field name="inherit_id" ref="mail.mail_guest_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="WhatsApp">
                    <field name="whatsapp_remote_jid" readonly="1" />
                    <field name="whatsapp_number" readonly="1" />
                    <field name="last_push_name" readonly="1" />
                    <field name="last_seen" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
