<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gap_checklist_wizard_form" model="ir.ui.view">
        <field name="name">dev.gap.checklist.wizard.form</field>
        <field name="model">mail_discuss_hub_dev.gap_checklist_wizard</field>
        <field name="arch" type="xml">
            <form string="Gap Checklist">
                <group>
                    <field name="provider"/>
                    <field name="gateway_id"/>
                </group>
                <group>
                    <field name="direction"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <group>
                    <button name="action_build" type="object" string="Build Checklist" class="btn-primary"/>
                </group>
                <separator string="Results"/>
                <div class="o_form_label">Use Build Checklist to open the gap report.</div>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_gap_checklist_line_list" model="ir.ui.view">
        <field name="name">dev.gap.checklist.line.list</field>
        <field name="model">mail_discuss_hub_dev.gap_checklist_line</field>
        <field name="arch" type="xml">
            <list string="Gap Checklist">
                <field name="priority"/>
                <field name="gateway_type"/>
                <field name="event_label"/>
                <field name="event_key"/>
                <field name="event_raw_sample"/>
                <field name="count"/>
                <field name="last_seen"/>
                <field name="last_log_id"/>
                <field name="todo_ref"/>
            </list>
        </field>
    </record>

    <record id="view_gap_checklist_line_form" model="ir.ui.view">
        <field name="name">dev.gap.checklist.line.form</field>
        <field name="model">mail_discuss_hub_dev.gap_checklist_line</field>
        <field name="arch" type="xml">
            <form string="Gap Checklist">
                <group>
                    <field name="priority" readonly="1"/>
                    <field name="gateway_type" readonly="1"/>
                </group>
                <group>
                    <field name="event_label" readonly="1"/>
                    <field name="event_key" readonly="1"/>
                    <field name="event_raw_sample" readonly="1"/>
                </group>
                <group>
                    <field name="count" readonly="1"/>
                    <field name="last_seen" readonly="1"/>
                    <field name="last_log_id" readonly="1"/>
                </group>
                <group>
                    <field name="todo_ref" readonly="1"/>
                    <field name="todo_url" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_gap_checklist_wizard" model="ir.actions.act_window">
        <field name="name">Gap Checklist</field>
        <field name="res_model">mail_discuss_hub_dev.gap_checklist_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_gap_checklist_wizard"
        name="Gap Checklist"
        parent="mail_discuss_hub_gateway_devtools.mail_discuss_hub_gateway_devtools_menu_webhooks"
        action="action_gap_checklist_wizard"
        sequence="120"
        groups="base.group_system"
    />
</odoo>
