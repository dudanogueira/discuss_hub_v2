<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connection_simulator_wizard_form" model="ir.ui.view">
        <field name="name">dev.connection.simulator.wizard.form</field>
        <field name="model">mail_discuss_hub_dev.connection_simulator_wizard</field>
        <field name="arch" type="xml">
            <form string="Connection Simulator">
                <group>
                    <field name="gateway_id"/>
                    <field name="direction"/>
                    <field name="event"/>
                </group>
                <group>
                    <field name="chat_id"/>
                    <field name="message_id"/>
                </group>
                <group>
                    <field name="from_me"/>
                    <field name="sender_jid"/>
                    <field name="sender_name"/>
                </group>
                <group>
                    <field name="text"/>
                </group>
                <group>
                    <field name="reaction"/>
                    <field name="reaction_target_id"/>
                    <field name="status"/>
                </group>
                <group>
                    <field name="process_now"/>
                </group>
                <footer>
                    <button name="action_simulate" type="object" string="Simulate" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_connection_simulator_wizard" model="ir.actions.act_window">
        <field name="name">Connection Simulator</field>
        <field name="res_model">mail_discuss_hub_dev.connection_simulator_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_connection_simulator_wizard"
        name="Connection Simulator"
        parent="mail_discuss_hub_gateway_devtools.mail_discuss_hub_gateway_devtools_menu_webhooks"
        action="action_connection_simulator_wizard"
        sequence="50"
        groups="base.group_system"
    />
</odoo>
