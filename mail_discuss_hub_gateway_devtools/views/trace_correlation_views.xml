<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trace_correlation_wizard_form" model="ir.ui.view">
        <field name="name">dev.trace.correlation.wizard.form</field>
        <field name="model">mail_discuss_hub_dev.trace_correlation_wizard</field>
        <field name="arch" type="xml">
            <form string="Trace Correlation">
                <group>
                    <field name="log_id"/>
                </group>
                <group>
                    <button name="action_correlate" type="object" string="Correlate" class="btn-primary"/>
                </group>
                <separator string="Results"/>
                <group>
                    <field name="correlation_strategy" readonly="1"/>
                    <field name="matched_channel_id" readonly="1"/>
                    <field name="matched_guest_id" readonly="1"/>
                </group>
                <field name="matched_message_ids" widget="many2many_tags" readonly="1"/>
                <field name="correlation_notes" readonly="1"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trace_correlation_wizard" model="ir.actions.act_window">
        <field name="name">Trace Correlation</field>
        <field name="res_model">mail_discuss_hub_dev.trace_correlation_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_trace_correlation_wizard"
        name="Trace Correlation"
        parent="mail_discuss_hub_gateway_devtools.mail_discuss_hub_gateway_devtools_menu_webhooks"
        action="action_trace_correlation_wizard"
        sequence="70"
        groups="base.group_system"
    />
</odoo>
