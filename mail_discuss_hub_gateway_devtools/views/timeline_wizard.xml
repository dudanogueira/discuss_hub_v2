<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timeline_wizard_form" model="ir.ui.view">
        <field name="name">dev.timeline.wizard.form</field>
        <field name="model">mail_discuss_hub_dev.timeline_wizard</field>
        <field name="arch" type="xml">
            <form string="Unified Timeline">
                <group>
                    <field name="channel_id"/>
                    <field name="guest_id"/>
                </group>
                <group>
                    <button name="action_build" type="object" string="Build Timeline" class="btn-primary"/>
                </group>
                <separator string="Timeline"/>
                <div class="o_form_label">Use Build Timeline to open the unified view.</div>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_timeline_line_tree" model="ir.ui.view">
        <field name="name">dev.timeline.line.tree</field>
        <field name="model">mail_discuss_hub_dev.timeline_line</field>
        <field name="arch" type="xml">
            <list string="Unified Timeline" create="0" delete="0">
                <field name="sequence"/>
                <field name="event_time"/>
                <field name="source_type"/>
                <field name="event"/>
                <field name="direction"/>
                <field name="http_status"/>
                <field name="title"/>
                <field name="details"/>
                <field name="webhook_log_id"/>
                <field name="message_id"/>
            </list>
        </field>
    </record>

    <record id="action_unified_timeline" model="ir.actions.act_window">
        <field name="name">Unified Timeline</field>
        <field name="res_model">mail_discuss_hub_dev.timeline_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_unified_timeline"
        name="Unified Timeline"
        parent="mail_discuss_hub_gateway_devtools.mail_discuss_hub_gateway_devtools_menu_channels"
        action="action_unified_timeline"
        sequence="80"
        groups="base.group_system"
    />
</odoo>
