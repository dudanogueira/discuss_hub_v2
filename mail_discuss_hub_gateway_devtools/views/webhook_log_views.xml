<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_gateway_webhook_log_view_search_dev" model="ir.ui.view">
        <field name="name">mail.gateway.webhook.log.search.dev</field>
        <field name="model">mail.gateway.webhook.log</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Webhook Logs">
                <field name="gateway_id"/>
                <field name="direction"/>
                <field name="event"/>
                <field name="status"/>
                <field name="internal_result"/>
                <field name="internal_routine"/>
                <field name="http_status"/>
                <field name="create_date"/>
                <field name="request_payload_search" string="Request Payload" filter_domain="[('request_payload_search', 'ilike', self)]"/>
                <separator/>
                <filter string="Inbound" name="direction_in" domain="[('direction', '=', 'in')]"/>
                <filter string="Outbound" name="direction_out" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter
                    string="Messages"
                    name="event_messages"
                    domain="['|', ('event', 'ilike', 'messages.'), ('event', 'ilike', 'message.')]"
                />
                <filter string="Presence" name="event_presence" domain="[('event', 'ilike', 'presence.')]"/>
                <filter string="Contacts" name="event_contacts" domain="[('event', 'ilike', 'contacts.')]"/>
                <filter
                    string="Groups"
                    name="event_groups"
                    domain="['|', ('event', 'ilike', 'groups.'), ('event', 'ilike', 'group.')]"
                />
                <separator/>
                <filter string="Received" name="status_received" domain="[('status', '=', 'received')]"/>
                <filter string="Processed" name="status_processed" domain="[('status', '=', 'processed')]"/>
                <filter string="Rejected" name="status_rejected" domain="[('status', '=', 'rejected')]"/>
                <filter string="Error" name="status_error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter
                    string="Internal Received"
                    name="internal_received"
                    domain="[('internal_result', '=', 'received')]"
                />
                <filter
                    string="Internal Processed"
                    name="internal_processed"
                    domain="[('internal_result', '=', 'processed')]"
                />
                <group expand="0" string="Group By">
                    <filter name="group_gateway" string="Gateway" context="{'group_by': 'gateway_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                    <filter name="group_routine" string="Routine" context="{'group_by': 'internal_routine'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mail_gateway_webhook_log_view_form_dev" model="ir.ui.view">
        <field name="name">mail.gateway.webhook.log.form.dev</field>
        <field name="model">mail.gateway.webhook.log</field>
        <field name="inherit_id" ref="mail_discuss_hub_gateway_devtools.mail_gateway_webhook_log_view_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Analysis (Dev)">
                    <group col="2">
                        <group>
                            <field name="analysis_enabled" invisible="1"/>
                            <field name="analysis_provider" readonly="1"/>
                            <field name="event" readonly="1"/>
                            <field name="analysis_routine" readonly="1"/>
                            <field name="analysis_error" readonly="1" widget="text"/>
                            <field name="analysis_message_id" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group>
                            <separator string="Raw Payload"/>
                            <field name="request_payload_pretty" nolabel="1" widget="text" readonly="1"/>
                        </group>
                        <group>
                            <separator string="Normalized Payload"/>
                            <field name="analysis_normalized_payload" nolabel="1" widget="text" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page string="Field Map (Dev)">
                    <group>
                        <field name="analysis_mapping_table_html" nolabel="1" widget="html" readonly="1"/>
                    </group>
                </page>
                <page string="Inspector (Dev)">
                    <group col="2">
                        <group>
                            <field name="inspector_enabled" invisible="1"/>
                            <field name="inspector_event" readonly="1"/>
                            <field name="inspector_error" readonly="1" widget="text"/>
                        </group>
                        <group>
                            <separator string="Missing Required Fields"/>
                            <field name="inspector_missing_fields" nolabel="1" widget="text" readonly="1"/>
                        </group>
                        <group>
                            <separator string="Used Fields"/>
                            <field name="inspector_used_fields" nolabel="1" widget="text" readonly="1"/>
                        </group>
                        <group>
                            <separator string="Diff vs Previous (Same Event)"/>
                            <field name="inspector_diff" nolabel="1" widget="text" readonly="1"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
