<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_provider_comparator_wizard_form" model="ir.ui.view">
        <field name="name">dev.provider.comparator.wizard.form</field>
        <field name="model">mail_discuss_hub_dev.provider_comparator_wizard</field>
        <field name="arch" type="xml">
            <form string="Provider Comparator">
                <group>
                    <field name="left_log_id"/>
                    <field name="left_gateway_type"/>
                    <field name="left_event"/>
                </group>
                <group>
                    <field name="right_log_id"/>
                    <field name="right_gateway_type"/>
                    <field name="right_event"/>
                </group>
                <group>
                    <button name="action_compare" type="object" string="Compare" class="btn-primary"/>
                </group>
                <notebook>
                    <page string="Left">
                        <field name="left_normalized" nolabel="1"/>
                    </page>
                    <page string="Right">
                        <field name="right_normalized" nolabel="1"/>
                    </page>
                    <page string="Diff">
                        <field name="diff_text" nolabel="1"/>
                    </page>
                    <page string="Notes">
                        <field name="notes" nolabel="1"/>
                    </page>
                </notebook>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_provider_comparator_wizard" model="ir.actions.act_window">
        <field name="name">Provider Comparator</field>
        <field name="res_model">mail_discuss_hub_dev.provider_comparator_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_provider_comparator_wizard"
        name="Provider Comparator"
        parent="mail_discuss_hub_gateway_devtools.mail_discuss_hub_gateway_devtools_menu_webhooks"
        action="action_provider_comparator_wizard"
        sequence="60"
        groups="base.group_system"
    />
</odoo>
