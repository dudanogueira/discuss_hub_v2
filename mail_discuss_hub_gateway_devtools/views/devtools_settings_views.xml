<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_devtools" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.devtools</field>
        <field name="model">res.config.settings</field>
        <field name="priority">95</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Devtools" string="Devtools" name="mail_discuss_hub_gateway_devtools">
                    <block title="Webhooks" id="devtools_webhooks">
                        <setting id="devtools_webhook_log_enabled" string="Persist webhook logs" help="Store inbound/outbound webhook payloads for debugging.">
                            <field name="webhook_log_enabled"/>
                        </setting>
                        <setting id="devtools_webhook_analysis_enabled" string="Webhook analysis panel">
                            <field name="webhook_analysis_enabled"/>
                        </setting>
                        <setting id="devtools_payload_inspector_enabled" string="Payload inspector">
                            <field name="payload_inspector_enabled"/>
                        </setting>
                        <setting id="devtools_controlled_replay_enabled" string="Controlled replay">
                            <field name="controlled_replay_enabled"/>
                        </setting>
                        <setting id="devtools_unified_timeline_enabled" string="Unified timeline">
                            <field name="unified_timeline_enabled"/>
                        </setting>
                        <setting id="devtools_idempotency_map_enabled" string="Idempotency map">
                            <field name="idempotency_map_enabled"/>
                        </setting>
                        <setting id="devtools_error_panel_enabled" string="Error panel">
                            <field name="error_panel_enabled"/>
                        </setting>
                        <setting id="devtools_connection_simulator_enabled" string="Connection simulator">
                            <field name="connection_simulator_enabled"/>
                        </setting>
                        <setting id="devtools_provider_comparator_enabled" string="Provider comparator">
                            <field name="provider_comparator_enabled"/>
                        </setting>
                        <setting id="devtools_trace_correlation_enabled" string="Trace correlation">
                            <field name="trace_correlation_enabled"/>
                        </setting>
                        <setting id="devtools_metrics_dashboard_enabled" string="Metrics dashboard">
                            <field name="metrics_dashboard_enabled"/>
                        </setting>
                        <setting id="devtools_gap_checklist_enabled" string="Gap checklist">
                            <field name="gap_checklist_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_devtools_config_settings" model="ir.actions.act_window">
        <field name="name">Devtools Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'mail_discuss_hub_gateway_devtools', 'bin_size': False}</field>
    </record>

    <menuitem
        id="menu_devtools_settings"
        name="Recursos"
        parent="mail_discuss_hub_gateway_devtools.mail_discuss_hub_gateway_devtools_menu_root"
        action="action_devtools_config_settings"
        sequence="5"
        groups="base.group_system"
    />
</odoo>
