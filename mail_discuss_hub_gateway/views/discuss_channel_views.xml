<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_discuss_hub_gateway.discuss_channel_view_form_messages" model="ir.ui.view">
        <field name="name">discuss.channel.form.messages</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='members']" position="after">
                <page string="Messages" name="messages">
                    <field
                        name="message_ids"
                        domain="[('model', '=', 'discuss.channel'), ('res_id', '=', id)]"
                        context="{'default_model': 'discuss.channel', 'default_res_id': id}"
                        create="0"
                        edit="0"
                        delete="0"
                        view_mode="list,form"
                        views="[(False, 'list'), (ref('mail.mail_message_view_form'), 'form')]"
                    >
                        <list string="Messages">
                            <field name="date" />
                            <field name="author_id" />
                            <field name="author_guest_id" />
                            <field name="message_type" />
                            <field name="subtype_id" />
                            <field name="body" widget="html" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
