<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_discuss_hub_gateway_inbox_view_list" model="ir.ui.view">
        <field name="name">mail.gateway.list.inbox</field>
        <field name="model">mail.gateway</field>
        <field name="arch" type="xml">
            <list string="Caixas de entrada">
                <field name="name" />
                <field name="gateway_type" />
                <field name="discuss_team_ids" widget="many2many_tags" />
                <field name="integrated_webhook_state" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_view_search" model="ir.ui.view">
        <field name="name">mail.gateway.search.inbox</field>
        <field name="model">mail.gateway</field>
        <field name="arch" type="xml">
            <search string="Caixas de entrada">
                <field name="name" />
                <field name="gateway_type" />
                <field name="discuss_team_ids" />
                <field name="company_id" />
                <filter string="Integrated" name="integrated" domain="[('integrated_webhook_state', '=', 'integrated')]"/>
            </search>
        </field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_view_form" model="ir.ui.view">
        <field name="name">mail.gateway.form.inbox</field>
        <field name="model">mail.gateway</field>
        <field name="inherit_id" ref="mail_gateway.mail_gateway_form_view" />
        <field name="priority" eval="90" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="after">
                <div class="oe_title" name="inbox_title">
                    <label for="name" string="Caixa de entrada" />
                    <h1 />
                </div>
                <group name="inbox_primary" />
            </xpath>
            <xpath expr="//div[@name='inbox_title']/h1" position="inside">
                <xpath expr="//field[@name='name']" position="move" />
            </xpath>
            <xpath expr="//group[@name='inbox_primary']" position="inside">
                <xpath expr="//field[@name='discuss_team_ids']" position="move" />
                <xpath expr="//field[@name='discuss_agent_ids']" position="move" />
            </xpath>
            <xpath expr="//group[@name='inbox_primary']/field[@name='discuss_agent_ids']" position="after">
                <field
                    name="member_ids"
                    string="Auto Assign"
                    widget="many2many_tags"
                    domain="[('groups_id', 'in', access_group_id)]"
                />
                <field name="outgoing_signature" />
                <field name="reopen_archived_conversations" />
                <field
                    name="outgoing_signature_format"
                    invisible="not outgoing_signature"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Gateway" name="gateway" />
            </xpath>
            <xpath expr="//page[@name='gateway']" position="inside">
                <xpath expr="//sheet/group[field[@name='token']]" position="move" />
            </xpath>
            <xpath expr="//page[@name='member']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_action" model="ir.actions.act_window">
        <field name="name">Caixas de entrada</field>
        <field name="res_model">mail.gateway</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mail_discuss_hub_gateway_inbox_view_list" />
        <field name="search_view_id" ref="mail_discuss_hub_gateway_inbox_view_search" />
        <field name="context">{'discuss_hub_inbox_view': 1}</field>
        <field name="domain">[]</field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_discuss_hub_gateway_inbox_view_list" />
        <field name="act_window_id" ref="mail_discuss_hub_gateway_inbox_action"/>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mail_discuss_hub_gateway_inbox_view_form" />
        <field name="act_window_id" ref="mail_discuss_hub_gateway_inbox_action"/>
    </record>

    <menuitem
        id="mail_discuss_hub_gateway_inbox_menu"
        name="Gateways"
        parent="mail_discuss_hub.mail_discuss_hub_inbox_menu_root"
        action="mail_discuss_hub_gateway.mail_discuss_hub_gateway_inbox_action"
        sequence="10"
        groups="base.group_system"
    />
</odoo>
