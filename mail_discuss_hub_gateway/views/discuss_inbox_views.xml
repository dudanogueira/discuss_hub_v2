<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_discuss_hub_gateway_inbox_view_list" model="ir.ui.view">
        <field name="name">discuss.hub.inbox.list.gateway</field>
        <field name="model">discuss.hub.inbox</field>
        <field name="inherit_id" ref="mail_discuss_hub.discuss_hub_inbox_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbox_type']" position="after">
                <field name="gateway_type" />
                <field name="discuss_team_ids" widget="many2many_tags" />
                <field name="integrated_webhook_state" />
            </xpath>
        </field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_view_search" model="ir.ui.view">
        <field name="name">discuss.hub.inbox.search.gateway</field>
        <field name="model">discuss.hub.inbox</field>
        <field name="inherit_id" ref="mail_discuss_hub.discuss_hub_inbox_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbox_type']" position="after">
                <field name="gateway_type" />
                <field name="discuss_team_ids" />
            </xpath>
            <xpath expr="//search" position="inside">
                <filter
                    string="Integrated"
                    name="integrated"
                    domain="[('integrated_webhook_state', '=', 'integrated')]"
                />
            </xpath>
        </field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_view_form" model="ir.ui.view">
        <field name="name">discuss.hub.inbox.form.gateway</field>
        <field name="model">discuss.hub.inbox</field>
        <field name="inherit_id" ref="mail_discuss_hub.discuss_hub_inbox_view_form" />
        <field name="priority" eval="90" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='inbox_primary']" position="inside">
                <field name="gateway_id" options="{'no_create': False}" />
                <field name="discuss_team_ids" widget="many2many_tags" />
                <field name="discuss_agent_ids" widget="many2many_tags" domain="[('share', '=', False)]" />
                <field
                    name="member_ids"
                    string="Auto Assign"
                    widget="many2many_tags"
                    domain="[('groups_id', 'in', access_group_id)]"
                />
                <field name="outgoing_signature" />
                <field name="reopen_archived_conversations" />
                <field
                    name="outgoing_signature_format"
                    invisible="not outgoing_signature"
                />
            </xpath>
        </field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_action" model="ir.actions.act_window">
        <field name="name">Caixas de entrada</field>
        <field name="res_model">discuss.hub.inbox</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mail_discuss_hub.discuss_hub_inbox_view_list" />
        <field name="search_view_id" ref="mail_discuss_hub.discuss_hub_inbox_view_search" />
        <field name="context">{'default_inbox_type': 'gateway'}</field>
        <field name="domain">[('inbox_type', '=', 'gateway')]</field>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mail_discuss_hub.discuss_hub_inbox_view_list" />
        <field name="act_window_id" ref="mail_discuss_hub_gateway_inbox_action"/>
    </record>

    <record id="mail_discuss_hub_gateway_inbox_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mail_discuss_hub.discuss_hub_inbox_view_form" />
        <field name="act_window_id" ref="mail_discuss_hub_gateway_inbox_action"/>
    </record>

    <menuitem
        id="mail_discuss_hub_inbox_menu_root"
        name="Caixas de entrada"
        parent="mail.menu_configuration"
        action="mail_discuss_hub_gateway.mail_discuss_hub_gateway_inbox_action"
        sequence="10"
        groups="base.group_system,mail_discuss_hub.group_discuss_hub_manager"
    />
</odoo>
