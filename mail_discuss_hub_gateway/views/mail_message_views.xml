<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_message_view_form_gateway_webhook" model="ir.ui.view">
        <field name="name">mail.message.view.form.gateway.webhook</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='gateway']" position="after">
                <page string="Webhook">
                    <group>
                        <group>
                            <field
                                name="gateway_webhook_log_id"
                                readonly="1"
                                options="{'no_create': True}"
                            />
                            <field name="gateway_webhook_event" readonly="1" />
                            <field name="gateway_webhook_direction" readonly="1" />
                            <field name="gateway_webhook_status" readonly="1" />
                        </group>
                        <group>
                            <field name="gateway_webhook_http_status" readonly="1" />
                            <field name="gateway_webhook_endpoint" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field
                                name="gateway_webhook_request_payload"
                                nolabel="1"
                                readonly="1"
                                widget="text"
                            />
                        </page>
                        <page string="Response">
                            <field
                                name="gateway_webhook_response_payload"
                                nolabel="1"
                                readonly="1"
                                widget="text"
                            />
                            <field
                                name="gateway_webhook_error_message"
                                nolabel="1"
                                readonly="1"
                                widget="text"
                            />
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
